# Edge route. Deployed to /srv/edge/sites/todo.caddy on the VM, then picked up by
# `docker exec edge-caddy caddy reload --config /etc/caddy/Caddyfile`.
#
# `todo` is the app's alias on the edge network (see compose.yaml), not a container name.
# TLS for this hostname is provisioned automatically on first request.
# Keep `log`: Caddy access logging is per site block, there is no global switch.
todo.kplanky.dev {
	log
	encode zstd gzip
	# Caddy redirects http to https but sends no HSTS of its own. Note `.dev` is an HSTS-preloaded
	# TLD (the whole TLD, with includeSubDomains), so a preload-list-aware browser already refuses
	# plaintext to this host and never sends that first cleartext request; this header is for the
	# clients that ship no preload list. includeSubDomains and preload cost nothing to assert for
	# the same reason: the TLD entry already commits every name under the domain.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy todo:8080
}
