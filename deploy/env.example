# Template for /srv/apps/todo/.env ON THE VM. Never committed, never leaves the box.
# Create it once by hand before the first deploy; CI ships compose.yaml, the initdb scripts and
# the image, never secrets. `docker compose` auto-loads this file from the stack directory.
#
#   install -m 600 /dev/null /srv/apps/todo/.env   # then fill in below
#
# Generate fresh passwords, do not reuse another app's:
#   openssl rand -base64 36
#
# TWO roles, deliberately. The admin role is the postgres superuser: initdb, the healthcheck and
# the nightly pg_dumpall use it (pg_dumpall requires superuser). The app role is what the webapp
# connects as, and it is NOT a superuser, so a SQL injection cannot reach COPY ... TO PROGRAM or
# pg_read_file. DB_ADMIN_USER must stay `todo`: that is the POSTGRES_USER this volume was
# initialized with, and renaming it would break the backup's role lookup.

DB_NAME=todo

DB_ADMIN_USER=todo
DB_ADMIN_PASSWORD=

DB_APP_USER=todo_app
DB_APP_PASSWORD=

# Optional. CI exports an immutable :sha tag over this on every deploy; it only matters for
# manual `docker compose up` and for pinning an old image during a rollback.
APP_IMAGE=ghcr.io/k-planky/todo-webapp:latest
